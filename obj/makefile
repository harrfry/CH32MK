-include ../makefile.defs

# Add inputs and outputs from these tool invocations to the build variables 
SECONDARY_FLASH += \
CH32MK.hex \

SECONDARY_LIST += \
CH32MK.lst \

SECONDARY_SIZE += \
CH32MK.siz \


# All Target
all: 
	$(MAKE) --no-print-directory main-build 

main-build: CH32MK.elf secondary-outputs

# Tool invocations
CH32MK.elf: $(OBJS) $(USER_OBJS_ESCAPE)
	@	riscv-none-embed-gcc -march=rv32imacxw -mabi=ilp32 -msmall-data-limit=8 -msave-restore -fmax-errors=20 -Os -fmessage-length=0 -fsigned-char -ffunction-sections -fdata-sections -fno-common -ffreestanding -Wunused -Wuninitialized -g -T "/home/harry/mounriver-studio-projects/CH32MK/Ld/Link.ld" -nostartfiles -Xlinker --gc-sections -Wl,-Map,"CH32MK.map" --specs=nano.specs --specs=nosys.specs -o "CH32MK.elf" $(OBJS) $(LIBS)
CH32MK.hex: CH32MK.elf
	@	riscv-none-embed-objcopy -O ihex "CH32MK.elf" "CH32MK.hex"
CH32MK.lst: CH32MK.elf
	@	riscv-none-embed-objdump --all-headers --demangle --disassemble -M xw "CH32MK.elf" > "CH32MK.lst"
CH32MK.siz: CH32MK.elf
	riscv-none-embed-size --format=berkeley "CH32MK.elf"

# Other Targets
clean:
	-$(RM) $(DIR_OBJS) $(SECONDARY_FLASH)$(SECONDARY_LIST)$(SECONDARY_SIZE) CH32MK.elf
	-$(RM) $(DIR_EXPANDS) $(CALLGRAPH_DOT)
	-$(RM) $(DIR_DEPS)
secondary-outputs: $(SECONDARY_FLASH) $(SECONDARY_LIST) $(SECONDARY_SIZE)

.PHONY: all clean dependents

-include ../makefile.targets